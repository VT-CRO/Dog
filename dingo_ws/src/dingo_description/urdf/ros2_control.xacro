<?xml version="1.0"?> 
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <!--to do xacro:macro CHECK HOW TO PROPERLY IMPLEMENT MACROS we can't just do xacro:include -->
    <!-- <xacro:macro name="dingo_ros2_control" params="name initial_positions_file">
   
        <xacro:property name="initial_positions" value="${xacro.load_yaml(initial_positions_file)['initial_positions']}"/> -->

    <xacro:if value="$(arg sim_mode)">
        <ros2_control name="GazeboSimSystem" type="system">
            <hardware>
                <plugin>gz_ros2_control/GazeboSimSystem</plugin>
            </hardware>

            <joint name="fr_theta1">
                <command_interface name="position"/>
                <state_interface name="position"/>                
                <!-- <state_interface name="position">
                    <param name="initial_value">${initial_positions['fr_theta1']}</param>
                </state_interface> -->
                <state_interface name="velocity"/>
            </joint>
            <joint name="fr_theta2">
                <command_interface name="position"/>
                <state_interface name="position"/>
                <!-- <state_interface name="position">
                    <param name="initial_value">${initial_positions['fr_theta2']}</param>
                </state_interface> -->
                <state_interface name="velocity"/>
            </joint>
            <joint name="fr_theta3">
                <command_interface name="position"/>
                <state_interface name="position"/>
                <!-- <state_interface name="position">
                    <param name="initial_value">${initial_positions['fr_theta3']}</param>
                </state_interface>             -->
                <state_interface name="velocity"/>
            </joint>

            <joint name="fl_theta1">
                <command_interface name="position"/>
                <state_interface name="position"/>
                <!-- <state_interface name="position">
                    <param name="initial_value">${initial_positions['fl_theta1']}</param>
                </state_interface>             -->
                <state_interface name="velocity"/>
            </joint>
            <joint name="fl_theta2">
                <command_interface name="position"/>
                <state_interface name="position"/>
                <!-- <state_interface name="position">
                    <param name="initial_value">${initial_positions['fl_theta2']}</param>
                </state_interface>             -->
                <state_interface name="velocity"/>
            </joint>
            <joint name="fl_theta3">
                <command_interface name="position"/>
                
                <state_interface name="position"/>
                <!-- <state_interface name="position">
                    <param name="initial_value">${initial_positions['fl_theta3']}</param>
                </state_interface>             -->
                <state_interface name="velocity"/>
            </joint>

            <joint name="rr_theta1">
                <command_interface name="position"/>
                <state_interface name="position"/>
                <!-- <state_interface name="position">
                    <param name="initial_value">${initial_positions['rr_theta1']}</param>
                </state_interface>             -->
                <state_interface name="velocity"/>
            </joint>
            <joint name="rr_theta2">
                <command_interface name="position"/>
                <state_interface name="position"/>
                <!-- <state_interface name="position">
                    <param name="initial_value">${initial_positions['rr_theta2']}</param>
                </state_interface>             -->
                <state_interface name="velocity"/>
            </joint>
            <joint name="rr_theta3">
                <command_interface name="position"/>
                <state_interface name="position"/>
                <!-- <state_interface name="position">
                    <param name="initial_value">${initial_positions['rr_theta3']}</param>
                </state_interface>             -->
                <state_interface name="velocity"/>
            </joint>

            <joint name="rl_theta1">
                <command_interface name="position"/>
                <state_interface name="position"/>
                <!-- <state_interface name="position">
                    <param name="initial_value">${initial_positions['rl_theta1']}</param>
                </state_interface>             -->
                <state_interface name="velocity"/>
            </joint>
            <joint name="rl_theta2">
                <command_interface name="position"/>
                <state_interface name="position"/>
                <!-- <state_interface name="position">
                    <param name="initial_value">${initial_positions['rl_theta2']}</param>
                </state_interface>             -->
                <state_interface name="velocity"/>
            </joint>
            <joint name="rl_theta3">
                <command_interface name="position"/>
                <state_interface name="position"/>
                <!-- <state_interface name="position">
                    <param name="initial_value">${initial_positions['rl_theta3']}</param>
                </state_interface>             -->
                <state_interface name="velocity"/>
            </joint>
        </ros2_control>
    </xacro:if>


    <xacro:unless value="$(arg sim_mode)">
        <ros2_control name="RealRobot" type="system">
            <hardware> <!--tells ROS 2 control to use DiffDriveArduino plugin. -->
                <!-- <plugin>diffdrive_arduino/DiffDriveArduinoHardware</plugin> -->
                <!-- <param name="left_wheel_name">left_wheel_joint</param>
                <param name="right_wheel_name">right_wheel_joint</param>
                <param name="loop_rate">30</param>
                <param name="device">/dev/ttyUSB0</param>
                <param name="baud_rate">57600</param>
                <param name="timeout">1000</param>
                <param name="enc_counts_per_rev">3436</param> -->
            </hardware>
            <!-- joint definitions -->
            <!-- <joint name="left_wheel_joint">
                <command_interface name="velocity">
                    <param name="min">-10</param>
                    <param name="max">10</param>
                </command_interface>
                <state_interface name="velocity"/>
                <state_interface name="position"/>
            </joint>
            <joint name="right_wheel_joint">
                <command_interface name="velocity">
                    <param name="min">-10</param>
                    <param name="max">10</param>
                </command_interface>
                <state_interface name="velocity"/>
                <state_interface name="position"/>
            </joint> -->
        </ros2_control>
    </xacro:unless>

    <gazebo>
        <plugin name="gz_ros2_control::GazeboSimROS2ControlPlugin" filename="libgz_ros2_control-system.so">
            <!-- <ros2_control_parameters>package://dingo_gazebo/config/controllers.yaml</ros2_control_parameters> -->
            <parameters>/home/robogames/Desktop/Dog/dingo_ws/src/dingo_gazebo/config/controllers.yaml</parameters>
            <!-- <parameters>$(find mini_car_bot)/config/gaz_ros2_ctl_use_sim.yaml</parameters> -->
        </plugin>
    </gazebo>
    <!-- </xacro:macro>   -->
</robot>