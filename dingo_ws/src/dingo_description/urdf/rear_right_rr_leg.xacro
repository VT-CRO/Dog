    <!-- JOINTS -->

    <joint
        name="rr_theta1"
        type="revolute">
        <origin
        xyz="-0.111650000000003 -0.0609999999999995 -0.0144000000000178"
        rpy="1.57079632679492 0 1.5707963267949" />
        <parent
        link="base_link" />
        <child
        link="rr_link1" />
        <axis
        xyz="0 0 -1" />
        <limit
        lower="-0.785398"
        upper="0.785398"
        effort="100.0"
        velocity="3" />
        <!-- <joint_properties damping="1000.0" friction="1000.0"/> -->
        <joint_properties damping="10.0" friction="0.0"/>
    </joint>
    <joint
        name="rr_theta2"
        type="revolute">
        <origin
        xyz="-0.0495999992169147 0.0144000000000178 0"
        rpy="1.57079631992506 1.57079572077363 -1.57079633366473" />
        <parent
        link="rr_link1" />
        <child
        link="rr_link2" />
        <axis
        xyz="0 0 1" />
        <limit
        lower="-3"
        upper="3"
        effort="100.0"
        velocity="3" />
        <!-- <joint_properties damping="1000.0" friction="1000.0"/> -->
        <joint_properties damping="10.0" friction="0.0"/>
    </joint>
    <joint
        name="rr_theta3"
        type="revolute">
        <origin
        xyz="0.13000000353672 0 0"
        rpy="0 0 1.57079598438978" />
        <parent
        link="rr_link2" />
        <child
        link="rr_link3" />
        <axis
        xyz="0 0 0.999999999999998" />
        <limit
        lower="-3"
        upper="3"
        effort="100.0"
        velocity="3" />
        <!-- <joint_properties damping="1000.0" friction="1000.0"/> -->
        <joint_properties damping="10.0" friction="0.0"/>
    </joint>
    <joint
        name="rr_foot"
        type="fixed">
        <origin
        xyz="0.138136646352431 0 0"
        rpy="0 0 0" />
        <parent
        link="rr_link3" />
        <child
        link="rr_link4" />
        <axis
        xyz="0 0 0" />
    </joint>

    <!--GAZEBO-->

    <!-- RR4 friction -->
    <gazebo reference="rr_link4">
