<?xml version="1.0"?> <!-- this will include all urdf files -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="dingo_bot">
   
    <xacro:arg name="initial_positions_file" default="/home/robogames/Desktop/Dog/dingo_ws/src/dingo_description/config/initial_positions.yaml" />

    <xacro:arg name="use_ros2_control" default="true"/>
    <xacro:arg name="sim_mode" default="true"/>

    <xacro:include filename="dingo.core.xacro"/>

    <xacro:if value="$(arg use_ros2_control)">
        <xacro:include filename="ros2_control.xacro"/>
    </xacro:if>
    <xacro:unless value="$(arg use_ros2_control)">
        <xacro:include filename="gazebo_control.xacro"/>
    </xacro:unless> 
  
</robot>

